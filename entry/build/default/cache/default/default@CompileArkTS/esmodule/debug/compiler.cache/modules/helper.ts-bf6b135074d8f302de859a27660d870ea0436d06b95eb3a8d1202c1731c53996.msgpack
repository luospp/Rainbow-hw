export function getBleState() {
    let bleState = access.BluetoothState.STATE_OFF;
    try {
        bleState = access.getState();
        console.debug(`get state ble state :${bleState}`);
    }
    catch (err) {
        // æ— æƒé™
        console.error(`getBleState errCode: ${err.code}, errMessage: ${err.message}`);
    }
    return bleState;
}
export async function getGrantStatus() {
    // è·å–åº”ç”¨ç¨‹åºçš„accessTokenID
    let tokenId = 0;
    let grantStatus = abilityAccessCtrl.GrantStatus.PERMISSION_DENIED;
    try {
        tokenId =
            (await bundleManager.getBundleInfoForSelf(bundleManager.BundleFlag.GET_BUNDLE_INFO_WITH_APPLICATION)).appInfo.accessTokenId;
        // æ ¡éªŒåº”ç”¨æ˜¯å¦è¢«æˆäºˆæƒé™
        grantStatus =
            await abilityAccessCtrl.createAtManager().checkAccessToken(tokenId, 'ohos.permission.ACCESS_BLUETOOTH');
    }
    catch (err) {
        console.error(`getGrantStatus errCode: ${err.code}, errMessage: ${err.message}`);
    }
    return grantStatus;
}
export async function jumpToSetting(context) {
    let bundleName = (await bundleManager.getBundleInfoForSelf(bundleManager.BundleFlag.GET_BUNDLE_INFO_WITH_APPLICATION)).appInfo.name;
    console.log(`bundle name: ${bundleName}`);
    let wantInfo = {
        bundleName: 'com.huawei.hmos.settings',
        abilityName: 'com.huawei.hmos.settings.MainAbility',
        uri: 'application_info_entry',
        parameters: {
            pushParams: bundleName // åº”ç”¨çš„ bundleName
        }
    };
    await context.startAbility(wantInfo).catch((err) => {
        console.error(`startAbility errCode: ${err.code}, errMessage: ${err.message}`);
    });
}
export async function askUserAuthorize(context, userAgreeCallback = null, userDenyCallback = null, notPopCallback = null) {
    let result = await abilityAccessCtrl.createAtManager()
        .requestPermissionsFromUser(context, ['ohos.permission.ACCESS_BLUETOOTH'])
        .catch((err) => console.error(`errCode: ${err.code}, errMessage: ${err.message}`));
    if (result) {
        let grantStatus = result.authResults[0];
        console.info(`grant status: ${grantStatus}`);
        if (grantStatus === 0) {
            if (userAgreeCallback) {
                userAgreeCallback();
            }
        }
        else {
            if (result.dialogShownResults && result.dialogShownResults[0]) {
                // å¼¹çª—äº†ï¼Œç”¨æˆ·æ²¡æœ‰åŒæ„
                if (userDenyCallback) {
                    userDenyCallback();
                }
            }
            else {
                if (notPopCallback) {
                    notPopCallback();
                }
            }
        }
    }
    else {
        console.info("no result");
    }
}
export async function enableBle(bleOnCallback = null) {
    access.on('stateChange', state => {
        if (state == access.BluetoothState.STATE_ON) {
            access.off('stateChange');
            if (bleOnCallback) {
                bleOnCallback();
            }
        }
        console.debug(`bluetooth statues: ${state}`);
    });
    try {
        console.debug("enableBle");
        access.enableBluetooth();
    }
    catch (err) {
        console.error(`enableBluetooth errCode: ${err.code}, errMessage: ${err.message}`);
    }
}
export async function startBleScan(scanResultCallback) {
    ble.on('BLEDeviceFind', scanResult => {
        scanResultCallback(scanResult.filter(result => result.connectable).map(result => ({
            name: result.deviceName, rssi: result.rssi, macAddress: result.deviceId
        })));
    });
    try {
        console.log("ble.startBLEScan");
        ble.startBLEScan([{}], {
            interval: 1000,
            dutyMode: ble.ScanDuty.SCAN_MODE_LOW_POWER,
            matchMode: ble.MatchMode.MATCH_MODE_AGGRESSIVE
        });
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
}
export function stopBleScan() {
    try {
        console.log("ble.stopBLEScan");
        ble.stopBLEScan();
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
}
let connectedDevice = undefined;
let serviceList = [];
export async function connectToDevice(macAddress, connectedCallback = null, disconnectedCallback = null, servicesCallback = null, characteristicNotifyCallback = null) {
    connectedDevice = ble.createGattClientDevice(macAddress);
    connectedDevice?.on('BLEConnectionStateChange', async (state) => {
        let connectState = state.state;
        if (connectState === constant.ProfileConnectionState.STATE_CONNECTED) {
            if (connectedCallback) {
                connectedCallback();
            }
            connectedDevice?.on('BLECharacteristicChange', (characteristic) => {
                if (characteristicNotifyCallback) {
                    characteristicNotifyCallback(getShortUUID(characteristic.characteristicUuid), arrayBufferToString(characteristic.characteristicValue));
                }
            });
            serviceList = await connectedDevice?.getServices();
            if (servicesCallback) {
                servicesCallback(serviceList);
            }
        }
        else if (connectState === constant.ProfileConnectionState.STATE_DISCONNECTED) {
            if (disconnectedCallback) {
                disconnectedCallback();
            }
            // è¿™å¥å¾ˆå…³é”®ï¼Œå–æ¶ˆè®¢é˜…æ‰€æœ‰äº‹ä»¶
            connectedDevice?.close();
            connectedDevice = null;
        }
    });
    try {
        connectedDevice?.connect();
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
    return connectedDevice;
}
export async function disconnectDevice() {
    try {
        connectedDevice?.disconnect();
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
}
// æ ¹æ®BLEåè®®ï¼ŒæŠŠUUIDæ”¹ä¸ºçŸ­å†™æ¨¡å¼ï¼Œæ–¹ä¾¿æ“ä½œ
export const getShortUUID = (src) => {
    const regex = /0000(\w{4})-/g;
    const matches = regex.exec(src);
    return matches != null ? matches[1] : src;
};
const strToArrayBuffer = (str) => {
    return buffer.from(str.toUpperCase().match(/[0-9A-F]{2}/g).map(s => parseInt(s, 16))).buffer;
};
const arrayBufferToString = (buff) => {
    let temp = "";
    let arr = new Uint8Array(buff);
    for (let i = 0; i < arr.byteLength; i++) {
        temp += arr[i].toString(16);
    }
    return temp;
};
const findTargetCharacteristic = (characteristicUUID) => {
    let targetCharacteristic = undefined;
    serviceList.forEach(service => {
        service.characteristics.forEach(characteristic => {
            if (getShortUUID(characteristic.characteristicUuid) == characteristicUUID) {
                targetCharacteristic = characteristic;
            }
        });
    });
    if (targetCharacteristic == undefined) {
        console.error(`characteristic ${characteristicUUID} not found`);
    }
    return targetCharacteristic;
};
export const readCharacteristic = async (characteristicUUID) => {
    try {
        let result = await connectedDevice?.readCharacteristicValue(findTargetCharacteristic(characteristicUUID));
        // return arrayBufferToString(result?.characteristicValue)
        return arrToStr(result?.characteristicValue);
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
};
// å‘é€éŸ³ä¹æŒ‡ä»¤
export const writeMusicCharacteristic = async (writeValue) => {
    let targetCharacteristic = findTargetCharacteristic("FFF3");
    targetCharacteristic.characteristicValue = strToBuffer(writeValue);
    try {
        await connectedDevice?.writeCharacteristicValue(targetCharacteristic, ble.GattWriteType.WRITE);
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
};
// å‘é€ç¯æ§æŒ‡ä»¤
export const writeLightCharacteristic = async (arr) => {
    let targetCharacteristic = findTargetCharacteristic("FFF1");
    targetCharacteristic.characteristicValue = convertToArrayBuffer(arr);
    try {
        await connectedDevice?.writeCharacteristicValue(targetCharacteristic, ble.GattWriteType.WRITE);
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
};
export const subscribeCharacteristic = (characteristicUUID) => {
    try {
        connectedDevice?.setCharacteristicChangeNotification(findTargetCharacteristic(characteristicUUID), true);
    }
    catch (err) {
        console.error(`errCode: ${err.code}, errMessage: ${err.message}`);
    }
};
/**
 * ASCII è§£ç ï¼šArrayBuffer è½¬ String
 * @param arrayBuffer å¾…è§£ç çš„äºŒè¿›åˆ¶ç¼“å†²åŒº
 * @returns è§£ç åçš„ ASCII å­—ç¬¦ä¸²ï¼ˆè¶…å‡º ASCII èŒƒå›´çš„å­—èŠ‚ä¼šè½¬ä¸ºå¯¹åº”å­—ç¬¦ï¼‰
 */
function arrToStr(arrayBuffer) {
    // 1. å°† ArrayBuffer è½¬ä¸º Uint8Array äºŒè¿›åˆ¶è§†å›¾ï¼Œä¾¿äºéå†å­—èŠ‚
    const uint8Array = new Uint8Array(arrayBuffer);
    let resultStr = "";
    // 2. éå†å­—èŠ‚ï¼Œå°†æ¯ä¸ªå­—èŠ‚è½¬ä¸ºå¯¹åº”çš„ ASCII å­—ç¬¦
    for (let i = 0; i < uint8Array.length; i++) {
        // String.fromCharCodeï¼šå°†å­—èŠ‚å€¼ï¼ˆ0-127ï¼‰è½¬ä¸ºå¯¹åº” ASCII å­—ç¬¦
        resultStr += String.fromCharCode(uint8Array[i]);
    }
    return resultStr;
}
/**
 *  ArrayBuffer ç±»å‹è¿”å›
 * @param arr å­—ç¬¦ä¸²æ•°ç»„ï¼ˆå¦‚ ["[", "T", "0x00", "]"]ï¼‰
 * @returns ArrayBuffer äºŒè¿›åˆ¶ç¼“å†²åŒºï¼Œè½¬æ¢å¤±è´¥è¿”å› null
 */
function convertToArrayBuffer(arr) {
    const byteList = []; // å…ˆå­˜å‚¨å­—èŠ‚æ•°å€¼ï¼ˆ0-255ï¼‰ï¼Œåç»­è½¬ä¸º Uint8Array
    for (const element of arr) {
        let byteValue;
        if (element.startsWith("0x")) {
            // å¤„ç†åå…­è¿›åˆ¶å­—ç¬¦ä¸²ï¼ˆå¦‚ "0x00" -> 0x00ï¼‰
            try {
                // æˆªå– "0x" åçš„éƒ¨åˆ†ï¼Œè½¬ä¸º16è¿›åˆ¶æ•´æ•°
                const hexStr = element.substring(2);
                const intValue = parseInt(hexStr, 16);
                // éªŒè¯å­—èŠ‚èŒƒå›´ï¼ˆ-128 ~ 127ï¼Œå¯¹åº” Byte ç±»å‹ï¼‰
                if (intValue < -128 || intValue > 255) {
                    console.log(`è¶…å‡ºå­—èŠ‚èŒƒå›´çš„åå…­è¿›åˆ¶å€¼ï¼š${element}`);
                    return null;
                }
                // è½¬æ¢ä¸º Byte å¯¹åº”çš„æ•°å€¼ï¼ˆå¤„ç†æ— ç¬¦å·/æœ‰ç¬¦å·å…¼å®¹ï¼‰
                byteValue = intValue > 127 ? intValue - 256 : intValue;
            }
            catch (e) {
                console.log(`æ— æ•ˆçš„åå…­è¿›åˆ¶å€¼ï¼š${element}ï¼Œå¼‚å¸¸ä¿¡æ¯ï¼š${e}`);
                return null;
            }
        }
        else {
            // å¤„ç†æ™®é€šå­—ç¬¦ï¼ˆå–ç¬¬ä¸€ä¸ªå­—ç¬¦çš„ ASCII ç ï¼‰
            if (element.length === 0) {
                console.log("ç©ºå­—ç¬¦ä¸²æ— æ³•è½¬æ¢ä¸ºå­—èŠ‚");
                return null;
            }
            // è·å–ç¬¬ä¸€ä¸ªå­—ç¬¦çš„ ASCII ç ï¼Œè½¬ä¸º Byte ç±»å‹
            byteValue = element.charCodeAt(0) & 0xFF; // ç¡®ä¿åœ¨å­—èŠ‚èŒƒå›´å†…
        }
        byteList.push(byteValue);
    }
    // å°†å­—èŠ‚æ•°å€¼åˆ—è¡¨è½¬ä¸º Uint8Arrayï¼Œå†è·å– ArrayBuffer è¿”å›
    const uint8Array = new Uint8Array(byteList);
    return uint8Array.buffer;
}
function strToBuffer(str) {
    // 1. åˆ›å»º TextEncoder å®ä¾‹ï¼Œé»˜è®¤ç¼–ç ä¸º UTF-8
    const encoder = new util.TextEncoder();
    // 2. å°†å­—ç¬¦ä¸²ç¼–ç ä¸º Uint8Array å­—èŠ‚æ•°ç»„
    const uint8Array = encoder.encode(str);
    // 3. æå– Uint8Array å¯¹åº”çš„ ArrayBuffer
    return uint8Array.buffer;
}
