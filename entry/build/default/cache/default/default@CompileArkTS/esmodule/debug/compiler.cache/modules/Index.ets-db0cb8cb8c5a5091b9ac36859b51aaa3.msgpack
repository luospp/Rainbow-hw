            this.jumpToSettingDialogController.open()
        })
    }

    onBleSwitchDialogConfirm() {
        enableBle(() => {
            this.startScan()
        })
    }

    onJumpToSettingDialogConfirm() {
        jumpToSetting(getContext() as common.UIAbilityContext)
    }

    stopScan() {
        this.bleScanning = false
        stopBleScan()
        if (this.scanTimer > 0) {
            clearTimeout(this.scanTimer)
            this.scanTimer = -1
        }
    }

