    get tempVolume() {
        return this.__tempVolume.get();
    }
    set tempVolume(newValue) {
        this.__tempVolume.set(newValue);
    }
    onStopTrackingTouch(progress) {
        if (progress !== undefined && progress !== null) {
            // å¤§äºŽ10ç›´æŽ¥å‘æ•°å­—
            if (progress >= 10) {
                this.sendMusicOrder("CA" + progress);
                this.tempVolume = progress;
            }
            else {
                if (this.tempVolume > 10) {
                    this.sendMusicOrder("CA10");
                    this.tempVolume = 10;
                }
                if (this.tempVolume === 10 || this.tempVolume > progress) {
                    const vSub = this.tempVolume - progress;
                    this.handVolume(vSub, progress, "CF");
                }
                else if (this.tempVolume < progress) {
                    const vSub = progress - this.tempVolume;
                    this.handVolume(vSub, progress, "CE");
                }
            }
        }
    }
    async handVolume(vSub, progress, order) {
        // åˆ›å»ºä¸€ä¸ªå¼‚æ­¥ä»»åŠ¡æ¥æ¨¡æ‹ŸKotlinçš„lifecycleScope.launch(Dispatchers.IO)
        for (let i = 0; i < vSub; i++) {
            // å»¶è¿Ÿ500æ¯«ç§’ï¼Œå¯¹åº”delay(Duration.ofMillis(500))
            await this.delay(500);
            this.sendMusicOrder(order);
        }
        // æ›´æ–°ä¸´æ—¶éŸ³é‡å€¼
        this.tempVolume = progress;
    }
    // å»¶è¿Ÿå‡½æ•°
    delay(ms) {
        return new Promise((resolve) => {
            // ä½¿ç”¨setTimeoutå®žçŽ°å»¶è¿Ÿ
            setTimeout(() => {
                resolve();
            }, ms);
        });
    }
    // èŽ·å–è‰²æ¸©æ–‡æœ¬æè¿°
    getColorTempTextss(value) {
        return "å†·è‰²";
    }
    getColorTempText(progress) {
        // å¯¹åº” Kotlin ä¸­çš„ when è¯­å¥ï¼Œä½¿ç”¨ TypeScript switch/if-else å®žçŽ°åˆ†æ”¯åˆ¤æ–­
        if (progress >= 0 && progress <= 30) {
            return "æ¸©æš–";
        }
        else if (progress >= 31 && progress <= 50) {
            return "æ¸©æš–";
        }
        else if (progress >= 51 && progress <= 70) {
            return "ç™½å…‰";
        }
        else if (progress >= 71 && progress <= 100) {
            return "å†·ç™½";
        }
        else {
            return "æ¸©æš–";
        }
    }
    rerender() {
        this.updateDirtyElements();
    }
    static getEntryName() {
        return "BleControl";
    }
}
registerNamedRoute(() => new BleControl(undefined, {}), "", { bundleName: "com.amdm.newble", moduleName: "entry", pagePath: "pages/BleControl", pageFullPath: "entry/src/main/ets/pages/BleControl", integratedHsp: "false", moduleType: "followWithHap" });
//# sourceMappingURL=BleControl.js.mapÂ–Ùi␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.router.d.tsÙ[/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/utils/LogUtils.tsÙW/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/ble/helper.tsÙd/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/dialogs/BleWriteDialog.etsÙ_/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/component/LampTab.etsÙ]/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/pages/BleButton.etsÙ^/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entry/src/main/ets/pages/BleControl.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ</Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entryÙ6/Users/luoshipeng/DevEcoStudioProjects/open_ble_helper¥entry¥1.0.0Ô␀␀Ù</Users/luoshipeng/DevEcoStudioProjects/open_ble_helper/entryÃÃÚkVimport { App, router } from '@kit.ArkUI';
import { ble } from '@kit.ConnectivityKit';
import { LogUtil } from '../utils/LogUtils';
import {
  BleDevice,
  connectToDevice,
  disconnectDevice,
  getShortUUID,
  readCharacteristic,
  subscribeCharacteristic,
  writeLightCharacteristic,
  writeMusicCharacteristic
} from '../ble/helper';
import { BleWriteDialog } from '../dialogs/BleWriteDialog';
import { LampTab } from '../component/LampTab';
import { BleButton } from './BleButton';

interface BleService {
  uuid: string
  characteristicList: BleCharacteristic[]
}

interface BleCharacteristic {
  uuid: string
  write?: boolean
  notify?: boolean
  read?: boolean
}

@Entry
@Component
struct BleControl {
  @State macAddress: string = "00:00:00:00:00:00"
  @State deviceLog: string = ""
  @State serviceList: BleService[] = []
  @State currentTab: number = 0; // 0: ç¯å…‰, 1: éŸ³ä¹
  @State connectFlag: number = 0; // è¿žæŽ¥çŠ¶æ€ ï¼š1 æœªè¿žæŽ¥ã€2 è¿žæŽ¥æˆåŠŸ 3ã€è¿žæŽ¥å¤±è´¥
  @State cBrightness: number = 0;
  @State colorTemp: number = 0;
  @State volume: number = 0;
  @State switchFlag: boolean = false
  bleWriteDialogController: CustomDialogController = new CustomDialogController({
    builder: BleWriteDialog({
      confirm: (sentValue: string) => {
        this.sendMusicOrder(sentValue)
      }
    }),
    alignment: DialogAlignment.Bottom
  })

  appendLog(logText: string) {
    this.deviceLog = logText + "\n" + this.deviceLog
    // LogUtil.d(this.deviceLog)
  }

  aboutToAppear(): void {
    this.macAddress = (router.getParams() as BleDevice)?.macAddress || this.macAddress

    connectToDevice(this.macAddress, () => {
      this.connectFlag = 2

    }, () => {
      //æ–­å¼€è¿”å›ž
      this.onBackPress()
    }, (serviceList: Array<ble.GattService>) => {
      this.serviceList = []
      serviceList.forEach(service => {
        let serviceItem: BleService = { uuid: getShortUUID(service.serviceUuid), characteristicList: [] }
        service.characteristics.forEach(characteristic => {
          let properties = characteristic.properties
          let characteristicItem: BleCharacteristic =
            {
              uuid: getShortUUID(characteristic.characteristicUuid),
              write: properties?.write || properties?.writeNoResponse,
              read: properties?.read,
              notify: properties?.notify
            }
          serviceItem.characteristicList.push(characteristicItem)
        })
        this.serviceList.push(serviceItem)
      })
    }, (shortUUID: string, characteristicValue: string) => {
      this.appendLog(`${shortUUID} notify: ${characteristicValue}`)
    })
  }

  aboutToDisappear() {
    disconnectDevice()
  }

  onBackPress(): boolean | void {

    const options: router.RouterOptions = {
      url: 'pages/Index', // å¦‚æžœéœ€è¦è¿”å›žæŒ‡å®šé¡µé¢åˆ™ä¿ç•™
      params: { key: 'value' } // ä¼ é€’éœ€è¦çš„å‚æ•°
    };
    router.back(options)

    return true
  }

  @Builder
  serviceHead(text: string) {
    Text(text)
      .width("100%")
      .backgroundColor("#ff5f74ff")
      .padding(10)
      .borderRadius(5)
      .fontColor(Color.White)
  }

  async readBle(shortUUID: string) {
    let result = await readCharacteristic(shortUUID)
    this.appendLog(`read ${shortUUID}: ${result}`)
  }

  subscribeBle(shortUUID: string) {
    this.appendLog(`subscribe ${shortUUID}`)
    subscribeCharacteristic("FFF1")
  }

  sendMusicOrder(order: string) {
    const str = "AT+" + order
    writeMusicCharacteristic(str)
    this.appendLog(`write FFF3: ${str}`)
    LogUtil.d(str)
  }

  sendLightOrder(type: string, value: string) {

    let data = ["[", type, value, "]"]
    writeLightCharacteristic(data)
    this.appendLog(`write FFF3: ${data}`)
    LogUtil.d(data.toString())
  }

  connectStr(): string {
    let state = ""
    switch (this.connectFlag) {
      case 1: {
        state = "æ­£åœ¨è¿žæŽ¥"
      }
      case 2: {
        state = "è“ç‰™å·²è¿žæŽ¥"
      }
    }
    return state
  }

  connectColor(): ResourceColor {
    let color: ResourceColor = $r('app.color.connecting')
    switch (this.connectFlag) {
      case 1: {
        color = $r('app.color.connecting')
      }
      case 2: {
        color = $r('app.color.colorAccent')
      }
      // case 3: {
      //   color = $r('app.color.disconnected')
      // }
    }
    LogUtil.d("è“ç‰™è¿žæŽ¥çŠ¶æ€ï¼š" + this.connectFlag)
    return color
  }

  build() {
    Column() {
      // é¡¶éƒ¨å›¾ç‰‡åŒºåŸŸ
      Stack({ alignContent: Alignment.TopStart }) {
        // èƒŒæ™¯å›¾ç‰‡
        Image($r('app.media.top_img'))
          .width('100%')
          .height(240)
          .objectFit(ImageFit.Cover)
          .backgroundColor(Color.Black)

        // é¡¶éƒ¨å†…å®¹
        Column({ space: 0 }) {
          // ç¬¬ä¸€è¡Œï¼šLogoå’Œè¿žæŽ¥çŠ¶æ€
          Row({ space: 0 }) {
            // Logo
            Image($r('app.media.top_logo'))
              .width(80)
              .height(21)
              .margin({ left: 16 }).align(Alignment.Start)
            Blank()
            // è¿žæŽ¥çŠ¶æ€
            Text(this.connectStr())
              .constraintSize({ minWidth: 80 })
              .height(20)
              .fontSize(12)
              .textAlign(TextAlign.Center)
              .fontColor(Color.White)
              .backgroundColor(this.connectColor())
              .borderRadius(10)
              .padding({
                left: 6,
                right: 6,
                top: 2,
                bottom: 2
              })
              .margin({ right: 14 })

            // è®¾ç½®æŒ‰é’®
            Image($r('app.media.iv_setting'))
              .width(15)
              .height(15)
              .margin({ right: 14 })
              .opacity(0.7)
              .onClick(() => {
                // è·³è½¬åˆ°è®¾ç½®é¡µé¢
                LogUtil.d("æ‰“å¼€è®¾ç½®ç•Œé¢")
                this.bleWriteDialogController.open()

              })
          }
          .width('100%').margin({ top: 26 })
          .justifyContent(FlexAlign.Start)


          // ä¸»æ ‡é¢˜å’Œå‰¯æ ‡é¢˜
          Column() {
            Text($r('app.string.primary_name'))
              .fontSize(30)
              .fontColor(Color.White)
              .margin({ top: 20 })

            Text($r('app.string.sub_name'))
              .fontSize(20)
              .fontColor(Color.White)
              .margin({ top: 10 })
          }
          .alignItems(HorizontalAlign.Start)
          .margin({ left: 16, top: 20 })
          .align(Alignment.Start)
        }.alignItems(HorizontalAlign.Start)
      }
      .width('100%')
      .height(240)


      // ä¸»å†…å®¹åŒºåŸŸ
      Column({ space: 0 }) {
        Column({ space: 0 }) {
          // Tabåˆ‡æ¢
          LampTab({
            // ä¼ é€’å›žè°ƒå‡½æ•°
            onTabSelected: (index: number) => {
              this.currentTab = index;
            }
          })


          // æ ¹æ®å½“å‰Tabæ˜¾ç¤ºä¸åŒå†…å®¹
          if (this.currentTab === 0) {
            // ç¯å…‰æŽ§åˆ¶
            this.LightControlView()
          } else {
            // éŸ³ä¹æŽ§åˆ¶
            this.MusicControlView()
          }
        }
        .backgroundColor($r('app.color.white'))
        .borderRadius(20)
        .padding(20)
        .margin({ left: 18, right: 18, top: -29 })

        // æ»‘å—æŽ§åˆ¶åŒºåŸŸ
        if (this.currentTab === 0) {
          this.LightSeekbarView()
        } else {
          this.MusicSeekbarView()
        }
      }
      .width('100%').margin({ top: 10 })

      // æ—¥å¿—
      // TextArea({ text: this.deviceLog })
      //   .padding(10)
      //   .width("100%")
      //   .height('30%')
      //   .backgroundColor(Color.Transparent)
    }
    .height('100%')
    .width('100%').backgroundColor($r('app.color.background'))
  }

  // ç¯å…‰æŽ§åˆ¶è§†å›¾
  @Builder
  LightControlView() {
    Column() {
      // å¼€å…³å’Œæ–¹å‘æŽ§åˆ¶è¡Œ
      Row() {
        // å¼€å…³æŒ‰é’®
        BleButton({
          buttonText: $r('app.string.on_off'),
          icon: $r('app.media.iv_switch_normal'),
          textColor: $r('app.color.mainTone'),
          onButtonClick: () => {
            // å¼€å…³æŽ§åˆ¶
            const order = this.switchFlag ? "0x00" : "0x01"
            this.switchFlag = !this.switchFlag
            this.sendLightOrder("T", order)
          }
        }).margin({ right: 36, top: 10 })


        // æ–¹å‘æŽ§åˆ¶
        Column({ space: 0 }) {
          Row() {
            // å‘ä¸Š
            Column({ space: 8 }) {
              Column() {
                Image($r('app.media.iv_up_normal'))
                  .width(20)
                  .height(20)
              }
              .width(44)
              .height(44)
              .backgroundColor($r('app.color.circle_bg'))
              .borderRadius(22)
              .justifyContent(FlexAlign.Center)
              .alignItems(HorizontalAlign.Center)
              .onClick(() => {
                // å‘ä¸ŠæŽ§åˆ¶
                this.sendLightOrder("E", "0x01")
              })

              Text($r('app.string.up'))
                .fontSize(12)
                .fontColor($r('app.color.main_tone')).margin({ top: 6 })
            }.margin({ left: 15 })

            // åœæ­¢
            Column({ space: 8 }) {
              Column() {
                Image($r('app.media.iv_play_normal'))
                  .width(20)
                  .height(20)
              }
              .width(44)
              .height(44)
              .backgroundColor($r('app.color.circle_bg'))
              .borderRadius(22)
              .justifyContent(FlexAlign.Center)
              .alignItems(HorizontalAlign.Center)
              .onClick(() => {
                // åœæ­¢æŽ§åˆ¶
                this.sendLightOrder("E", "0x00")
              })

              Text($r('app.string.stop'))
                .fontSize(12)
                .fontColor($r('app.color.main_tone')).margin({ top: 6 })
            }

            // å‘ä¸‹
            Column({ space: 8 }) {
              Column() {
                Image($r('app.media.iv_down_normal'))
                  .width(20)
                  .height(20)
              }
              .width(44)
              .height(44)
              .backgroundColor($r('app.color.circle_bg'))
              .borderRadius(22)
              .justifyContent(FlexAlign.Center)
